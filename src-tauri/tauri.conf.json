{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ZURY",
  "version": "0.1.0",
  "identifier": "app.local.ai-video-editor",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "ZURY",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Video",
    "shortDescription": "Local-first AI video editor",
    "longDescription": "A local-first professional video editor with an extensible on-device generative-AI engine. No account, no mandatory cloud. Optionally syncs projects to a GitHub repository."
  }
}
